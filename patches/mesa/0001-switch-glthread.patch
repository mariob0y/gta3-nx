+//-----------------------------------------------------------------------------
+// glthread
+//-----------------------------------------------------------------------------
+
+// Set when the last context made here started glthread, so an application
+// linking this library can tell it is running with one (and, for instance,
+// stop mapping buffers, which glthread has to synchronise on).
+__attribute__((visibility("default"))) int mesa_switch_glthread_active = 0;
+
+// Called by glthread's worker as it starts (st_set_background_context). DRI
+// binds the EGL context to the worker here; nothing this driver does on the
+// worker's behalf - framebuffer validation, front-buffer flushes - consults
+// EGL's per-thread state, so there is nothing to bind.
+static void
+switch_st_set_background_context(struct st_context_iface *stctxi,
+                                 struct util_queue_monitoring *queue_info)
+{
+    (void)stctxi;
+    (void)queue_info;
+}
+
+// Wait until glthread's worker has executed everything queued on the
+// current context, before this thread touches the pipe context or a
+// resource the queued commands may still use. A no-op without glthread.
+// (dri_unbind_context, dri_flush and dri_set_tex_buffer2 do the same.)
+static void
+switch_finish_current(void)
+{
+    _EGLContext *ctx = _eglGetCurrentContext();
+    if (!ctx)
+        return;
+    struct switch_egl_context *context = switch_egl_context(ctx);
+    if (context->stctx && context->stctx->thread_finish)
+        context->stctx->thread_finish(context->stctx);
+}
+
 //-----------------------------------------------------------------------------
 // EGL driver methods
 //-----------------------------------------------------------------------------
@@ -351,8 +388,10 @@ switch_destroy_surface(_EGLDriver *drv, _EGLDisplay *disp, _EGLSurface *surf)
     struct switch_egl_surface* surface = switch_egl_surface(surf);
     CALLED();
 
-    if (_eglPutSurface(surf))
+    if (_eglPutSurface(surf)) {
+        switch_finish_current();
         switch_egl_surface_cleanup(surface);
+    }
 
     return EGL_TRUE;
 }
@@ -490,6 +529,7 @@ switch_initialize(_EGLDriver *drv, _EGLDisplay *dpy)
     }
 
     stmgr->get_param = switch_st_get_param;
+    stmgr->set_background_context = switch_st_set_background_context;
 
     // Create nouveau screen
     TRACE("Creating nouveau screen\n");
@@ -607,6 +647,17 @@ switch_create_context(_EGLDriver *drv, _EGLDisplay *dpy, _EGLConfig *conf,
         goto cleanup;
     }
 
+    // glthread: GL calls are recorded on the application's thread and
+    // executed by a worker (src/mesa/main/glthread.c), which on this platform
+    // pins itself to another core. Opt-in, as DRI's driconf option of the
+    // same name is: the application sets mesa_glthread=true in its
+    // environment before creating the context.
+    mesa_switch_glthread_active = 0;
+    if (context->stctx->start_thread && env_var_as_boolean("mesa_glthread", false)) {
+        context->stctx->start_thread(context->stctx);
+        mesa_switch_glthread_active = 1;
+    }
+
     return &context->base;
 
 cleanup:
@@ -644,6 +695,9 @@ switch_make_current(_EGLDriver* drv, _EGLDisplay* dpy, _EGLSurface *dsurf,
     _EGLContext *old_ctx;
     _EGLSurface *old_dsurf, *old_rsurf;
 
+    // The outgoing context's queued commands run before it is unbound.
+    switch_finish_current();
+
     if (!_eglBindContext(ctx, dsurf, rsurf, &old_ctx, &old_dsurf, &old_rsurf))
         return EGL_FALSE;
 
@@ -687,6 +741,11 @@ switch_swap_buffers(_EGLDriver *drv, _EGLDisplay *dpy, _EGLSurface *surf)
         return EGL_TRUE;
     }
 
+    // Everything the frame queued has to reach the pipe context before this
+    // thread flushes it and reads the back buffer's fence.
+    if (context->stctx->thread_finish)
