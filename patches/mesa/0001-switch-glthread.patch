+#ifdef __SWITCH__
+/* From libnx (switch/kernel/svc.h). Declared rather than included: libnx's
+ * switch/types.h defines ALIGN and BIT, which main/macros.h defines too. */
+extern uint32_t svcSetThreadCoreMask(uint32_t handle, int32_t core_id, uint32_t affinity_mask);
+#define SWITCH_CUR_THREAD_HANDLE 0xFFFF8000u
+#endif
+
 static void
 glthread_thread_initialization(void *job, int thread_index)
 {
    struct gl_context *ctx = (struct gl_context*)job;
 
+#ifdef __SWITCH__
+   /* Horizon starts a new thread on its creator's core, at a lower priority
+    * than an application's main thread, so a worker left there only runs
+    * while the application waits and nothing is done in parallel. Moved to a
+    * core of its own: mesa_glthread_core, 1 unless set; 3 or more (the
+    * system's core) leaves it where it is. */
+   const unsigned core = env_var_as_unsigned("mesa_glthread_core", 1);
+   if (core < 3)
+      svcSetThreadCoreMask(SWITCH_CUR_THREAD_HANDLE, (int32_t)core, 1u << core);
+#endif
+
    ctx->Driver.SetBackgroundContext(ctx, &ctx->GLThread.stats);
    _glapi_set_context(ctx);
 }
