+#ifdef __SWITCH__
+#include <pthread.h>
+#include <stdlib.h>
+
+/* thrd_create gives a thread libnx's default stack of 128 KiB. A Mesa worker
+ * - glthread's - runs the GLSL compiler and the nouveau back end, which
+ * compile shader variants at draw time too, and those want far more. So on
+ * this platform a Mesa thread is a pthread with a 1 MiB stack. (thrd_t is a
+ * pthread_t in devkitPro's newlib, so thrd_join and the rest still apply.) */
+#define U_THREAD_SWITCH_STACK_SIZE (1024 * 1024)
+
+struct u_thread_switch_start {
+   int (*routine)(void *);
+   void *param;
+};
+
+static inline void *
+u_thread_switch_entry(void *arg)
+{
+   struct u_thread_switch_start start = *(struct u_thread_switch_start *)arg;
+   free(arg);
+   return (void *)(intptr_t)start.routine(start.param);
+}
+#endif
+
 #ifdef __FreeBSD__
 #define cpu_set_t cpuset_t
 #endif
